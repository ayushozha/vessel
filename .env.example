# Copy to .env.local. Vessel runs locally only; open it at http://127.0.0.1:3000.

# Enables "Continue with ChatGPT" using OpenAI's documented flow for locally run apps.
# OpenAI only redirects back to 127.0.0.1, so do not use localhost. A hosted deployment needs OpenAI approval.
CHATGPT_LOCAL_MODE=true

# Optional. Where API keys and ChatGPT tokens are stored. Defaults to ~/.config/vessel/credentials.json.
# VESSEL_CREDENTIALS_PATH=

# Optional. A first generation plans the files, then writes them in parallel: how many model calls at once (default 4).
# 0 turns planning off: every run is a single streamed call.
# GENERATION_CONCURRENCY=4
# Optional. A run is stopped after this many seconds (default 600).
# RUN_TIMEOUT_SECONDS=600
